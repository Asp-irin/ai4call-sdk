# BasicAssistantFlow

main: kit: flow: BasicAssistantFlow:
{
  entity: "assistant",
  kind: "basic",
  name: "BasicAssistantFlow",
  step: [
    {
      i: {
        ref: "assistant_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "assistant_ref01",
        srcdatavar: "assistant_ref01_data",
        suffix: "_up0",
        textfield: "description"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-assistant_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "assistant_ref01",
        srcdatavar: "assistant_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "assistant01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-assistant_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "assistant_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "assistant01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicAssistantFlow"
}