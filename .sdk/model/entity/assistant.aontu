# Entity: assistant

main: kit: entity: assistant: {

  alias: field: {}

  fields: {
    assistant: {
      h: "Assistant"
      n: "assistant"
      r: true
      sh: "Assistant detail response, including the legacy assistant API key during the v1 compatibility period."
