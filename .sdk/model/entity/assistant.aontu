      t: "`$OBJECT`"
    }
    mode: {
      h: "Mode"
      n: "mode"
      r: false
      sh: "Runtime mode to use when creating the assistant."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "Assistant name."
      t: "`$STRING`"
    }
    network: {
      h: "Network"
      n: "network"
      r: false
      sh: "Network settings to update on the assistant."
      t: "`$OBJECT`"
    }
    numbers: {
      h: "Numbers"
      n: "numbers"
      r: false
      sh: "Replacement values for assistant number lists when supplied."
      t: "`$OBJECT`"
    }
    requestId: {
      h: "Request Id"
      n: "requestId"
      r: true
      t: "`$STRING`"
    }
    settings: {
      h: "Settings"
      n: "settings"
      r: false
      sh: "High-level assistant settings to update."
      t: "`$OBJECT`"
    }
    status: {
      h: "Status"
      n: "status"
      r: false
      sh: "New lifecycle status for the assistant."
      t: "`$STRING`"
    }
    success: {
      h: "Success"
      n: "success"
      r: true
      t: "`$BOOLEAN`"
    }
    voiceToVoice: {
      de: true
      h: "Voice To Voice"
      n: "voiceToVoice"
      r: false
      sh: "Legacy alias of `audioToAudio`."
      t: "`$OBJECT`"
    }
  }

  id: {
    field: "id"
