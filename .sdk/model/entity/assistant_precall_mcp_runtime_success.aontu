    }
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "PATCH /api/v1/assistants/{assistantId}/runtime/precall/mcp-config"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "205"
                k: "param"
                n: "assistant_id"
                or: "assistantId"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "PATCH"
          o: "/api/v1/assistants/{assistantId}/runtime/precall/mcp-config"
          q: {
            exist: [
              "assistant_id"
            ]
          }
          r: {
            param: {
              assistantId: "assistant_id"
            }
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "assistants"
            }
            {
